# Copy to .env for local development. Replace every placeholder before use.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
REDIS_URL=rediss://USER:PASSWORD@HOST:6379
ENCRYPTION_SECRET=replace-with-at-least-32-random-characters
SLACK_SIGNING_SECRET=replace-with-your-slack-signing-secret
DASHBOARD_JWT_SECRET=replace-with-at-least-32-random-characters
NEXTAUTH_SECRET=replace-with-at-least-32-random-characters
LEMON_SQUEEZY_WEBHOOK_SECRET=replace-with-your-lemon-squeezy-webhook-secret

# Configure these together to enable Slack OAuth.
# SLACK_CLIENT_ID=your-slack-client-id
# SLACK_CLIENT_SECRET=your-slack-client-secret
# SLACK_REDIRECT_URI=https://your-domain.example/api/auth/slack/callback

# NextAuth can infer its URL from request headers, but an explicit production URL is recommended.
NEXTAUTH_URL=https://your-domain.example
