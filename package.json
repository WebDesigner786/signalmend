{
  "name": "signalmend",
  "version": "0.1.0",
  "private": true,
  "description": "Automated incident response and webhook processing engine",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build && npm run build:worker",
    "start": "next start",
    "build:worker": "tsc --project tsconfig.server.json",
    "worker:dev": "ts-node --project tsconfig.server.json src/workers/webhookWorker.ts",
    "worker": "node dist/workers/webhookWorker.js",
    "worker:slack-handshake:dev": "ts-node --project tsconfig.server.json src/workers/slackHandshakeWorker.ts",
    "worker:slack-handshake": "node dist/workers/slackHandshakeWorker.js",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run",
    "setup:github": "node scripts/setup-github.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "@prisma/client": "6.12.0",
    "bullmq": "^5.34.3",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "ioredis": "^5.4.2",
    "lucide-react": "^1.63.0",
    "next": "^15.5.28",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "recharts": "^3.10.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.32",
    "prisma": "6.12.0",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
